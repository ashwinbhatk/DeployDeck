# Local development defaults only. Replace before exposing the host.
DATABASE_URL=postgresql://deploydeck:deploydeck_local@localhost:5432/deploydeck
BASE_DOMAIN=localhost
PUBLIC_PORT=8080
# Generate each key independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
# Exact browser origin. HTTPS enables Secure cookies. Local HTTP is for development only.
APP_ORIGIN=http://localhost:3000
